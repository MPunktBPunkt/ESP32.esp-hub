# Doxygen for esp-hub-base (see ../docs/KOMMENTARSTANDARD.md).
# Usage: cd esp-hub-base && doxygen Doxyfile  ->  build/docs/html/index.html

PROJECT_NAME           = "esp-hub-base"
PROJECT_BRIEF          = "ESP32.esp-hub base firmware — https://github.com/MPunktBPunkt/ESP32.esp-hub"
PROJECT_NUMBER         = 1.9.7
OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

INPUT                  = . src ../docs/KOMMENTARSTANDARD.md ../docs/update/README.md
FILE_PATTERNS          = *.h *.cpp *.ino *.md
RECURSIVE              = YES
EXCLUDE                = build
USE_MDFILE_AS_MAINPAGE = ../docs/KOMMENTARSTANDARD.md

JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
# PROGMEM HTML blobs and config macros are not API docs.
EXCLUDE_SYMBOLS        = PAGE_CSS PAGE_BODY PAGE_SCRIPT PAGE_SCRIPT2 \
                         OTA_PAGE OTA_SCRIPT OTA_SCRIPT2 \
                         DEVICE_NAME FW_VERSION HUB_HOST HUB_PORT WIFI_AP_NAME \
                         WIFI_PORTAL_TIMEOUT_S DEFAULT_INTERVAL_S WATCHDOG_TIMEOUT_S \
                         RESET_BUTTON_PIN RESET_HOLD_SEC
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "FW_VERSION=\"doc\"" ARDUINO=10819 BOARD_HAS_PSRAM=1

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = build/docs/doxygen-warnings.log

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
